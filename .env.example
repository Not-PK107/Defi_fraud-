# Etherscan API Key for fetching wallet transactions
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Infura / Alchemy RPC URL for connecting to the Ethereum Sepolia Testnet
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_infura_project_id

# Private key for the wallet deploying/writing to the smart contract (Never share this publicly!)
PRIVATE_KEY=your_metamask_wallet_private_key_here

# The deployed smart contract address on Sepolia
CONTRACT_ADDRESS=your_deployed_contract_address_here
